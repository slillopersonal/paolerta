source "https://rubygems.org"

# Usa esattamente le versioni di Jekyll e dei plugin che GitHub Pages
# utilizza in produzione, così quello che vedi in locale è identico
# a quello che verrà pubblicato.
gem "github-pages", group: :jekyll_plugins

# Necessario su Ruby 3.0+ per alcune dipendenze di github-pages
gem "webrick"
